{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "secret_key_change_later_for_prod",
    "Issuer": "ProductionCalculator",
    "Audience": "ProductionCalculatorUsers",
    "ExpireMinutes": 60
  },
  "RefreshToken": {
    "ExpireDays": 28,
    "MaxSessions": 10
  },
  "VerificationCode": {
    "ExpireMinutes": 15,
    "MaxRequests": 3,
    "MaxAttempts": 5
  }
}
